{
  "name": "react-template",
  "sideEffects": false,
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "cross-env SITE_NAME=wjau webpack serve --config ./internals/webpack/webpack.local.js",
    "test": "jest --config ./internals/jest/jest.config.js",
    "standard-check": "standard",
    "standard-fix": "standard --fix",
    "pre-commit": "npm run standard-check && npm run test",
    "build": "cross-env NODE_ENV=production webpack",
    "bundle-analyzer": "cross-env NODE_ENV=production webpack --json > stats.json && npx webpack-bundle-analyzer stats.json build/wjau --port 1234",
    "prepare": "husky"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.2.3",
    "@webjet/react": "3.3.3",
    "@webjet/react-icons": "^3.7.9",
    "classnames": "2.5.1",
    "core-js": "3.37.0",
    "date-fns": "2.30.0",
    "fetch-retry": "5.0.6",
    "formik": "^2.4.6",
    "isomorphic-fetch": "3.0.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-gallery": "^1.0.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "react-redux": "9.1.2",
    "yup": "0.32.11"
  },
  "devDependencies": {
    "@babel/core": "7.24.5",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-transform-runtime": "7.24.3",
    "@babel/preset-env": "7.24.5",
    "@babel/preset-react": "7.24.1",
    "babel-loader": "9.1.3",
    "babel-plugin-transform-react-remove-prop-types": "0.4.24",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "9.0.0",
    "cross-env": "7.0.3",
    "css-loader": "6.8.1",
    "html-replace-webpack-plugin": "2.6.0",
    "html-webpack-plugin": "5.6.0",
    "husky": "9.0.11",
    "jest": "29.7.0",
    "less": "4.2.0",
    "less-loader": "12.2.0",
    "mini-css-extract-plugin": "1.6.2",
    "react-router-dom": "6.23.0",
    "standard": "17.1.0",
    "terser-webpack-plugin": "5.3.10",
    "webpack": "5.94.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.0.4",
    "webpack-merge": "5.10.0"
  },
  "standard": {
    "ignore": [
      "**/config.**"
    ],
    "env": [
      "jest"
    ],
    "globals": [
      "Cypress",
      "cy"
    ]
  }
}
